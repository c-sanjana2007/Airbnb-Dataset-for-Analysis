      <aliases enabled='yes' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption='Price Category' datatype='string' name='[Calculation_0154234977038336]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;LUXURY&quot;&#13;&#10;ELSEIF [Price]&gt;= 150 THEN &quot;STANDARD&quot;&#13;&#10;ELSE&quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0154234979500033]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_0154234980016130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;High Review&quot;&#13;&#10;ELSE &quot;Low Review&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0154234986971141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 0154234984706052]&#13;&#10;THEN &quot;ABOVE LIMIT&quot;&#13;&#10;ELSE &quot;BELOW LIMIT&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since' datatype='datetime' name='[Calculation_0575623507193857]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='updated_neighbourhood1' datatype='string' name='[Calculation_0575623509544962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood ],&quot;Unknown&quot;)' />
      </column>
      <column caption='Review_Scores_Rating (bin)' datatype='string' name='[Calculation_0575623510081539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]),&quot;Not Rated&quot;)' />
      </column>
      <column caption='Updated_beds' datatype='integer' name='[Calculation_0575623511109636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds],0)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='datetime' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column caption='Neighbourhood' datatype='string' name='[Neighbourhood ]' role='dimension' type='nominal' />
      <column caption='Property Type1' datatype='string' name='[Property Type]' role='dimension' type='nominal' />
      <column datatype='string' name='[Room Type (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[Room Type]' new-bin='true'>
          <bin default-name='false' value='&quot;Budget Stay&quot;'>
            <value>&quot;Private room&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Premium Stay&quot;'>
            <value>&quot;Entire home/apt&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Shared Accomodation&quot;'>
            <value>&quot;Shared room&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[Room Type]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
